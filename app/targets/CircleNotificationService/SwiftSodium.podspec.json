{
  "name": "SwiftSodium",
  "version": "0.9.1",
  "swift_versions": "5.0",
  "license": {
    "type": "ISC",
    "file": "LICENSE"
  },
  "summary": "Upstream Sodium 0.9.1, renamed: its libSodium.a product shadows the vendored libsodium.a (the actual C crypto) on a case-insensitive filesystem, leaving every _crypto_* symbol undefined at link time.",
  "homepage": "https://github.com/jedisct1/swift-sodium",
  "authors": {
    "Frank Denis": ""
  },
  "source": {
    "git": "https://github.com/jedisct1/swift-sodium.git",
    "tag": "0.9.1"
  },
  "platforms": {
    "ios": "12.0"
  },
  "source_files": "Sodium/**/*.{swift,h}",
  "private_header_files": "Sodium/libsodium/*.h",
  "pod_target_xcconfig": {
    "SWIFT_INCLUDE_PATHS": "$(inherited) \"${PODS_XCFRAMEWORKS_BUILD_DIR}/Clibsodium\" \"${PODS_XCFRAMEWORKS_BUILD_DIR}/SwiftSodium\""
  },
  "user_target_xcconfig": {
    "SWIFT_INCLUDE_PATHS": "$(inherited) \"${PODS_XCFRAMEWORKS_BUILD_DIR}/Clibsodium\" \"${PODS_XCFRAMEWORKS_BUILD_DIR}/SwiftSodium\""
  },
  "requires_arc": true,
  "vendored_frameworks": "Clibsodium.xcframework",
  "swift_version": "5.0"
}
