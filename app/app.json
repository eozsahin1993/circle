{
  "expo": {
    "name": "Mimoza",
    "slug": "mimoza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mimoza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.eozsahin.mimoza",
      "appleTeamId": "N323492Q8L",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.com.eozsahin.mimoza"
        ]
      }
    },
    "android": {
      "package": "com.eozsahin.mimoza",
      "adaptiveIcon": {
        "backgroundColor": "#2B3830",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14100C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE-WITH-IOS-CLIENT-ID-FOR-com.eozsahin.mimoza"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Circle uses your camera to scan a device transfer code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
