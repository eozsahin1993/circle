# Copy to .env.local, .env.staging or .env.production (all gitignored).
# Expo loads .env.local itself; the other two come from `npm run
# ios:staging` / `ios:prod`.

# local | staging | production — picks the bundle id, name, App Group and
# Firebase file (app.config.js). Unset means local.
APP_ENV=local

# `terraform output api_endpoint`. Unset locally: a dev build infers the
# packager's host.
EXPO_PUBLIC_RELAY_URL=http://localhost:8090

# From this environment's Google Cloud project. Must match its relay's
# GOOGLE_CLIENT_ID_* or every token is rejected.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
