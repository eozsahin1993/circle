# Copy to .env.local (Expo auto-loads .env / .env.local, not read by this
# repo's own code — EXPO_PUBLIC_* vars are just how Expo injects env vars
# into process.env at build/start time).

# Required for anything that talks to the relay (drainOutbox, pullCircle
# once it exists). Point this at a deployed relay's URL (see
# server/provision/outputs.tf's api_endpoint) or a local one for testing
# (see server/provision/local + `go run ./cmd/server`).
EXPO_PUBLIC_RELAY_URL=http://localhost:8080
