# Copy to .env.local (Expo auto-loads .env / .env.local, not read by this
# repo's own code — EXPO_PUBLIC_* vars are just how Expo injects env vars
# into process.env at build/start time).

# Required for anything that talks to the relay (drainOutbox, pullCircle
# once it exists). Point this at a deployed relay's URL (see
# server/provision/outputs.tf's api_endpoint) or a local one for testing
# (see server/provision/local + `go run ./cmd/server`).
EXPO_PUBLIC_RELAY_URL=http://localhost:8080

# Required for "Continue with Google" (index.tsx, via
# expo-auth-session/providers/google). OAuth client IDs from Google Cloud
# Console — not secret, they're the public "aud" side of an ID token, but
# they do need to match the relay's own GOOGLE_CLIENT_IDS (see
# server/.env.example) or the relay will reject every token as invalid.
# Set whichever platforms you're actually building for; an unset one is
# just omitted from the auth request.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
