# Secrets
.env

# Compiled binary from `go build ./cmd/server` — regenerate with `go run`/`go build`.
/server

# Compiled Lambda artifact — regenerate with provision/build.sh
provision/build/

# Terraform local state and provider cache — no remote backend configured
# yet (see versions.tf), so these stay machine-local. Matches both
# provision/ and provision/local/ (each is its own root config with its
# own state). The .lock.hcl files are NOT ignored — those are meant to be
# committed.
provision/**/.terraform/
provision/**/*.tfstate
provision/**/*.tfstate.*
provision/**/crash.log
provision/**/*.tfvars

# The FCM service-account key, for local runs (see FCM_CREDENTIAL_FILE).
# Anyone holding one can push arbitrary text to every user's lock screen.
# Matched anywhere in the name, not as a prefix: these arrive named after
# whatever project generated them.
*firebase-adminsdk*.json
*fcm*service*account*.json
*service-account*.json
