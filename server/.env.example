# Copy to .env and fill in for local runs of cmd/server or cmd/lambda
# outside Lambda's own environment. Go doesn't load .env files itself —
# nothing in this repo does dotenv loading yet — so either `export
# $(cat .env | xargs)` before running, or load it with a tool like
# direnv/godotenv if you add one.

# --- internal/config.Config — read by both cmd/lambda and cmd/server ---

# Required. Matches provision/outputs.tf's table_name after `terraform
# apply` (or provision/local/outputs.tf's, for a LocalStack instance —
# see provision/local/main.tf).
TABLE_NAME=circle-prod-sync-log

# Required. Matches provision/outputs.tf's bucket_name.
BUCKET_NAME=circle-prod-circle-blobs

# Required. Matches provision/outputs.tf's sessions_table_name (or
# provision/local/outputs.tf's, for LocalStack) — see
# server/DESIGN.md's "Email auth" section.
SESSIONS_TABLE_NAME=circle-prod-sessions

# Required. Matches provision/outputs.tf's accounts_table_name (or
# provision/local/outputs.tf's, for LocalStack) — see
# server/DESIGN.md's "Account recovery" section.
ACCOUNTS_TABLE_NAME=circle-prod-accounts

# Required. Matches provision/outputs.tf's invite_table_name (or
# provision/local/outputs.tf's, for LocalStack) — see
# server/INVITE_FLOW.md.
INVITE_TABLE_NAME=circle-prod-invites

# Required. Matches provision/outputs.tf's rate_limit_table_name (or
# provision/local/outputs.tf's, for LocalStack) — see
# server/internal/storage/ratelimitstore.
RATE_LIMIT_TABLE_NAME=circle-prod-rate-limit

# Optional, one per platform — the accepted "aud" value for Google Sign-In
# ID tokens from that platform's client in Google Cloud Console. Leave a
# platform blank if it's not in use yet; at least one should be set for
# Google sign-in to work at all. Not sensitive — client IDs are public by
# design. Must match app/.env.local's matching EXPO_PUBLIC_GOOGLE_*_CLIENT_ID.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# Optional — the accepted "aud" value for Sign in with Apple ID tokens:
# your app's iOS bundle ID. Not sensitive.
APPLE_CLIENT_ID_IOS=

# Optional — defaults to the adapter's own default (14) if unset. See
# server/DESIGN.md and provision/variables.tf's log_retention_days.
# Eviction itself is DynamoDB's native TTL, not this process — this only
# controls what expiresAt gets written as at commit time.
LOG_RETENTION_DAYS=14

# Optional — defaults to the adapter's own default (2 MiB) if unset. See
# provision/variables.tf's max_blob_size_bytes. Enforced by S3 itself via
# a signed content-length-range policy condition, not by the relay.
MAX_BLOB_SIZE_BYTES=2097152

# Optional — defaults to the adapter's own default (7) if unset. See
# server/INVITE_FLOW.md and provision/variables.tf's
# invite_retention_days. Eviction itself is DynamoDB's native TTL,
# not this process — this only controls what expiresAt gets written as at
# write time.
INVITE_RETENTION_DAYS=7

# Optional — defaults to 500/2000/10 if unset. Starting guesses, not
# measurements — see provision/variables.tf's rate_limit_*_max_requests
# and rate_limit_window_minutes, and server/internal/storage/ratelimitstore
# for the near-limit warning that's meant to inform retuning these later.
RATE_LIMIT_WRITE_MAX_REQUESTS=500
RATE_LIMIT_READ_MAX_REQUESTS=2000
RATE_LIMIT_WINDOW_MINUTES=10

# Optional — cmd/server only (cmd/lambda doesn't listen on a port). Defaults to 8080.
PORT=8080

# Optional, defaults to false. Only ever set this to true when running
# cmd/server against LocalStack (see provision/local) — LocalStack doesn't
# resolve virtual-hosted-style bucket subdomains the way real S3 does.
# Never set this against real AWS.
S3_FORCE_PATH_STYLE=false

# --- AWS SDK standard vars — not read by internal/config, read directly
# by awsconfig.LoadDefaultConfig in both cmd/ entry points ---

AWS_REGION=us-east-1
# Prefer AWS_PROFILE (an existing named profile from `aws configure`) over
# hardcoding a key pair here.
# AWS_PROFILE=your-profile-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# For a LocalStack instance instead of real AWS (see provision/local),
# uncomment these along with S3_FORCE_PATH_STYLE and the
# circle-local-* TABLE_NAME/BUCKET_NAME above. AWS_ENDPOINT_URL is a
# standard AWS SDK var — the SDK itself redirects every service call
# there, no code changes needed.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
