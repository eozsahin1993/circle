# One file per environment: copy to local.env, staging.env or prod.env
# (all gitignored). local.env is loaded directly for cmd/server runs:
# `(set -a; source local.env; set +a; go run ./cmd/server)` — Go doesn't
# load env files itself. staging.env/prod.env are uploaded to SSM with
# provision/push-config.sh, and the Lambda gets them from there. See
# README.md's "Running locally" and "Deploying".

# --- internal/config.Config — read by both cmd/lambda and cmd/server ---

# Required. Names every AWS resource the relay uses: the tables
# (<prefix>-sync-log, -sessions, -accounts, -invites, -rate-limit, -push),
# the bucket (<prefix>-blobs) and, in AWS, the push-credential SSM
# parameters (/<prefix>/fcm-service-account, /<prefix>/apns-auth-key).
# The same prefix Terraform creates them under — `terraform output
# resource_prefix` in provision/envs/<env>.
RESOURCE_PREFIX=mimoza-local

# Optional, one per platform — the accepted "aud" value for Google Sign-In
# ID tokens from that platform's client in Google Cloud Console. Leave a
# platform blank if it's not in use yet; at least one should be set for
# Google sign-in to work at all. Not sensitive — client IDs are public by
# design. Must match app/.env.local's matching EXPO_PUBLIC_GOOGLE_*_CLIENT_ID.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# Optional — the accepted "aud" value for Sign in with Apple ID tokens:
# your app's iOS bundle ID. Not sensitive.
APPLE_CLIENT_ID_IOS=

# Optional — defaults to the adapter's own default (2 MiB) if unset.
# Enforced by S3 itself via a signed content-length-range policy
# condition, not by the relay.
MAX_BLOB_SIZE_BYTES=2097152

# Optional — defaults to the adapter's own default (7) if unset. Eviction
# itself is
# DynamoDB's native TTL, not this process — this only controls what
# expiresAt gets written as at write time.
INVITE_RETENTION_DAYS=7

# Optional — defaults to 500/2000/500/10 if unset. Starting guesses, not
# measurements — see server/internal/ratelimit for the near-limit warning
# that's meant to inform retuning these later. PUSH budgets how many pushes
# one recipient may receive per window.
RATE_LIMIT_WRITE_MAX_REQUESTS=500
RATE_LIMIT_READ_MAX_REQUESTS=2000
RATE_LIMIT_PUSH_MAX_REQUESTS=500
RATE_LIMIT_WINDOW_MINUTES=10

# Optional — cmd/server only (cmd/lambda doesn't listen on a port). Defaults to 8080.
PORT=8080

# Optional, defaults to false. Only ever set this to true when running
# cmd/server against LocalStack (see provision/envs/local) — LocalStack doesn't
# resolve virtual-hosted-style bucket subdomains the way real S3 does.
# Never set this against real AWS.
S3_FORCE_PATH_STYLE=false

# --- AWS SDK standard vars — not read by internal/config, read directly
# by awsconfig.LoadDefaultConfig in both cmd/ entry points ---

AWS_REGION=us-east-1
# Prefer AWS_PROFILE (an existing named profile from `aws configure`) over
# hardcoding a key pair here.
# AWS_PROFILE=your-profile-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# For a LocalStack instance instead of real AWS (see provision/envs/local),
# uncomment these along with S3_FORCE_PATH_STYLE, with RESOURCE_PREFIX
# set to mimoza-local above. AWS_ENDPOINT_URL is a
# standard AWS SDK var — the SDK itself redirects every service call
# there, no code changes needed.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# The FCM service-account key. In AWS it's the SSM SecureString
# /<RESOURCE_PREFIX>/fcm-service-account, created by hand — never a
# Terraform resource, since a Terraform-managed value lands in state as
# plaintext. LocalStack has no parameter to read, so local runs point this
# at the key file instead. Keep it out of the repo; server/.gitignore already
# catches the names Google gives it.
# FCM_CREDENTIAL_FILE=./fcm-service-account.json

# Where the APNs auth key (.p8) lives. Local runs read it straight from
# disk — keep it out of the repo; server/.gitignore already catches *.p8.
# In AWS it's read from the SSM SecureString
# /<RESOURCE_PREFIX>/apns-auth-key instead (same reasoning as the FCM key).
APNS_AUTH_KEY_FILE=./AuthKey_XXXXXXXXXX.p8

# Required for push to reach iOS at all. From Apple Developer ->
# Certificates, Identifiers & Profiles -> Keys (KeyID) and -> Membership
# (TeamID). Not secret themselves — the .p8 file is the secret.
APNS_KEY_ID=
APNS_TEAM_ID=

# Required — the app's iOS bundle id, sent as apns-topic. Must match
# app/app.json's ios.bundleIdentifier.
APNS_TOPIC=com.eozsahin.mimoza

# Optional, defaults to false (sandbox). A debug-signed build's device
# token only works against sandbox; only a TestFlight/App Store build
# needs this set to true. See app/app.json's ios.entitlements.aps-environment,
# which must match.
APNS_PRODUCTION=false
