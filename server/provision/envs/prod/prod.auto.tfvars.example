# Copy to prod.auto.tfvars (gitignored; Terraform reads *.auto.tfvars with no
# flags) and fill in. Nothing here is secret — it's kept out of git because
# the values are per-person and per-account, not because they're sensitive.
#
# CI sets neither: it assumes its role via OIDC (ambient credentials, no
# profile) and passes the account id as TF_VAR_aws_account_id from a GitHub
# Environment variable.

aws_profile    = "mimoza-prod-admin"
aws_account_id = ""

# Where alarms mail — billing, throttles, errors, latency. Empty means
# none, and for billing that matters: AWS has no spending cap.
alert_email           = ""


# What this environment is. CI can't read this file, so the deploy
# workflow passes the same values as TF_VAR_* from its GitHub Environment
# — keep the two in step.
# api.<this> and cdn.<this>, under one wildcard certificate.
env_domain = ""

github_repository = "eozsahin1993/mimoza"

