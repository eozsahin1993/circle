# Copy to staging.auto.tfvars (gitignored; Terraform reads *.auto.tfvars with no
# flags) and fill in. Nothing here is secret — it's kept out of git because
# the values are per-person and per-account, not because they're sensitive.
#
# CI sets neither: it assumes its role via OIDC (ambient credentials, no
# profile) and passes the account id as TF_VAR_aws_account_id from a GitHub
# Environment variable.

aws_profile    = "mimoza-staging"
aws_account_id = ""

# Where the billing alarm mails. Empty means no alarm — AWS has no spending
# cap, so set it.
billing_alert_email   = ""
billing_threshold_usd = 20

# Set once the account exists and DNS is ready; empty leaves the raw
# function URL. See docs/INFRASTRUCTURE.md.
# api_domain = "staging-api.mimoza.app"
